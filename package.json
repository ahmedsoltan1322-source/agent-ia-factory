{
  "name": "agent-ia-factory",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode pages",
    "preview": "vite preview --host 0.0.0.0",
    "validate:foundation": "python scripts/validate_foundation.py",
    "validate:phase1": "node scripts/validate-phase1.mjs",
    "validate:phase2": "node scripts/validate-phase2.mjs",
    "validate:phase3": "node scripts/validate-phase3.mjs && node scripts/validate-phase3-mcp.mjs",
    "check": "npm run validate:foundation && npm run validate:phase1 && npm run validate:phase2 && npm run validate:phase3 && npm run build"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.82",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
